{
  "name": "macd-etf-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ETF MACD backtest UI with 512760 ServerChan notifications",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite web --host 127.0.0.1",
    "build": "vite build web --outDir ../dist --emptyOutDir",
    "start": "node --env-file=.env src/index.js",
    "test": "node --test",
    "test-notify": "node --env-file=.env scripts/send-test-message.js",
    "service:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-service.ps1",
    "service:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/uninstall-service.ps1",
    "service:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/manage-service.ps1 start",
    "service:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/manage-service.ps1 stop",
    "service:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/manage-service.ps1 status"
  },
  "devDependencies": {
    "vite": "^7.3.6"
  }
}
